# Clerk application keys (values come from Clerk setup; never commit real keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Canonical browser origin used to reject cross-origin cookie-authenticated writes
APP_ORIGIN=http://localhost:3000

# Supabase project API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Brevo transactional email delivery (only needed after Clerk webhook delivery is configured)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Rein
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional separate signing secret; when empty, the server derives the handoff key from CLERK_SECRET_KEY.
METADATA_TOKEN_SECRET=
# Optional separate secret for post-sign-in email codes and the verified-session cookie;
# when empty, the server derives it from CLERK_SECRET_KEY. Brevo values above are required to send codes.
EMAIL_OTP_SECRET=
